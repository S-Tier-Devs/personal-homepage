NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# Used by the digitalocean MCP server (.mcp.json), not by the app itself.
DIGITALOCEAN_API_TOKEN=
# DigitalOcean Spaces (blog media; bucket pb-public-media). SPACES_KEY/SECRET
# are secrets — live values go in via the live-spec procedure, never committed.
# SPACES_MEDIA_CDN_URL must be RUN_AND_BUILD_TIME in the app spec (CSP reads it
# at build). Prefer a per-bucket-limited key if DO offers one — verify.
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_MEDIA_BUCKET=pb-public-media
SPACES_MEDIA_CDN_URL=
