# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is the committed env contract — the negation keeps it tracked without
# needing `git add -f`. Verify with `git check-ignore .env.example` (should be silent).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — agent worktrees are full duplicate checkouts; local settings are per-machine.
# Deliberately not ignoring all of .claude/, so .claude/settings.json stays committable.
/.claude/worktrees/
/.claude/settings.local.json

# superpowers working state (the SDD ledger); logs
/.superpowers/
/logs/
